[gd_resource type="Resource" script_class="UiLibraryText" load_steps=36 format=3]

[ext_resource type="Script" path="res://scripts/ui/ui_library_text.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/ui_library_page.gd" id="2"]
[ext_resource type="Script" path="res://scripts/ui/ui_library_step.gd" id="3"]

[sub_resource type="Resource" id="Step_1_1"]
script = ExtResource("3")
heading = "PUGAD"
note = "about {pugad_s} s"
body = "PUGAD: each player grabs an egg (about {pugad_s} s). The egg hatches into a piece."
art = "pugad"

[sub_resource type="Resource" id="Step_1_2"]
script = ExtResource("3")
heading = "PLACE"
note = "about {place_s} s"
body = "PLACE: put your piece on the shared stage (about {place_s} s) and confirm to lock it."
art = "place"

[sub_resource type="Resource" id="Step_1_3"]
script = ExtResource("3")
heading = "PLAY"
note = "Run & jump"
body = "PLAY: run and jump through the stage everyone built. The stage stays and grows every round."
art = "play"

[sub_resource type="Resource" id="Page_1"]
script = ExtResource("2")
category = "How to Play"
title = "The round loop"
body = "Every round has three steps."
requires = ""
steps = Array[ExtResource("3")]([SubResource("Step_1_1"), SubResource("Step_1_2"), SubResource("Step_1_3")])

[sub_resource type="Resource" id="Page_2"]
script = ExtResource("2")
category = "How to Play"
title = "Controls"
body = "{controls}\n\nIn the Lobby the Rotate key opens this Library. During Play, a chicken that is out or has finished can use it to cheer."
requires = ""

[sub_resource type="Resource" id="Page_3"]
script = ExtResource("2")
category = "How to Play"
title = "Placing a piece"
body = "Move the ghost with the move keys and rotate it where the shape allows. A solid outline with OK is a valid spot; a dashed outline with an X is blocked and the reason is shown.\nYou cannot place on a chicken, the spawn, the flag platform or the base stage. The first player to confirm a spot claims it for the rest of Place."
requires = ""

[sub_resource type="Resource" id="Page_4"]
script = ExtResource("2")
category = "How to Play"
title = "The stage grows"
body = "Pieces stay between rounds and become terrain for every mode, including your own later runs. The base stage, spawn and flag cannot be changed. The next round's Main Challenge is announced during the Pugad before it so you can build for it."
requires = ""

[sub_resource type="Resource" id="Page_5"]
script = ExtResource("2")
category = "How to Play"
title = "Winning"
body = "First to {target} points wins, or the highest score after round {round_limit}. A tie plays a Sudden Death Lagsanay. Round 1 is always Karera and every 4th round is a Lagsanay."
requires = ""

[sub_resource type="Resource" id="Page_6"]
script = ExtResource("2")
category = "Karera"
title = "The race"
body = "Reach the flag alive. The round ends when every chicken has finished or is out, {finish_window} s after the first finisher, or at the {hard_cap} s cap. A chicken that is out can still cheer for the others."
requires = ""

[sub_resource type="Resource" id="Page_7"]
script = ExtResource("2")
category = "Karera"
title = "Scoring"
body = "Tapos +{tapos} for every chicken that reaches the flag.\nUna +{una} for the first to cross. There is no second- or third-place bonus in Karera.\nBayani +{bayani} if you are the only finisher (2 to 4 players).\nPatibong +{patibong} for each chicken eliminated by a trap you placed, if anyone finished.\nBawi +{bawi} if you were {bawi_gap} points behind the leader and finish."
requires = ""

[sub_resource type="Resource" id="Page_8"]
script = ExtResource("2")
category = "Karera"
title = "Too easy, too hard"
body = "If everyone finishes, Tapos, Una, Bayani, Patibong and Bawi award 0, even with 2 players. A chicken carrying Barya still earns its +0.5. If nobody finishes, no points are awarded. If some but not all finish, normal awards apply. Build stages that are hard but beatable."
requires = ""

[sub_resource type="Resource" id="Page_9"]
script = ExtResource("2")
category = "Karera"
title = "One challenge per round"
body = "Every round runs one standalone challenge: Karera, Lagsanay or Kangaroo. Lagsanay is the Bomb-Taya tag game; it is not combined with a race."
requires = ""

[sub_resource type="Resource" id="Page_10"]
script = ExtResource("2")
category = "Karera"
title = "Kangaroo is a race"
body = "Race to the flag while answering one sequential slipper challenge at a time. Finishers are secured; failed commands directly eliminate through race results."
requires = "main:KANGAROO"

[sub_resource type="Resource" id="Page_11"]
script = ExtResource("2")
category = "Lagsanay"
title = "Taya, pass and timer"
body = "One random chicken is the taya and is frozen for {head_start} s so the others can spread out. Then a countdown runs ({taya_4p} s with 4 alive, {taya_3p} s with 3, {taya_2p} s with 2). Touch another chicken to pass the taya; the chicken you just passed to cannot tag you back for {pass_back} s. When the timer ends the taya is out and a new taya is picked. Last chicken standing wins."
requires = ""

[sub_resource type="Resource" id="Page_12"]
script = ExtResource("2")
category = "Lagsanay"
title = "Placement points"
body = "Lagsanay scores by survival order (4 players): last survivor is 1st {place_1st}; 2nd {place_2nd}; 3rd {place_3rd}; first eliminated is 4th {place_4th} placement points. A fourth-place chicken still keeps direct Patibong +{patibong} per trap kill. Bawi +{bawi} applies if an underdog places first. There is no too-easy rule."
requires = ""

[sub_resource type="Resource" id="Page_13"]
script = ExtResource("2")
category = "Lagsanay"
title = "Last Cluck"
body = "If every remaining chicken is eliminated in the same instant, there is no shared first place. The chicken eliminated last wins; an exact tie goes to the lowest player number. The result screen shows LAST CLUCK!"
requires = ""

[sub_resource type="Resource" id="Page_14"]
script = ExtResource("2")
category = "Lagsanay"
title = "Bomb-Taya is standalone Lagsanay"
body = "Lagsanay is the Bomb-Taya tag game. The taya countdown runs in its own round; a timeout is an elimination (never a Patibong). Lagsanay uses survival placement scoring."
requires = ""

[sub_resource type="Resource" id="Page_15"]
script = ExtResource("2")
category = "Lagsanay"
title = "Sudden Death"
body = "If scores are tied at the end of the match, the tied players play a Lagsanay that always produces one winner. Sudden Death never has a Twist."
requires = ""

[sub_resource type="Resource" id="Page_16"]
script = ExtResource("2")
category = "Kangaroo"
title = "The giant slipper"
body = "A giant slipper signals one challenge at a time: normal, sole down = FREEZE; sole up = RISING WAVE; sideways = HUG. Each has an icon, text, sound and timing ring. Telegraph lasts {telegraph} s, then response begins at {response} s and shortens by 0.5 s per completed slipper to 3 s. Recovery begins at 1.5 s and shortens by 0.15 s to 0.75 s. Commands are equally likely and may repeat."
requires = "main:KANGAROO"

[sub_resource type="Resource" id="Page_17"]
script = ExtResource("2")
category = "Kangaroo"
title = "Freeze"
body = "When Freeze strikes, movement, jump and build controls lock for 2 s. Gravity, moving supports, external forces, capture and projectiles continue. It grants no invulnerability; started construction finishes. A translucent blue tint clears at thaw."
requires = "main:KANGAROO"

[sub_resource type="Resource" id="Page_18"]
script = ExtResource("2")
category = "Kangaroo"
title = "Rising wave"
body = "The target line appears before a slow rise. At response end, your current full hitbox must clear it within a tiny 1-unit tolerance. Submersion during the rise is safe. Support is not required; the visual drains after the one-time evaluation."
requires = "main:KANGAROO"

[sub_resource type="Resource" id="Page_19"]
script = ExtResource("2")
category = "Kangaroo"
title = "Hug"
body = "At response end, touch any other living eligible chicken. Pairs, groups and chains pass; isolated chickens fail. Hug can be drawn with two players and is skipped for a sole unfinished runner."
requires = "main:KANGAROO"

[sub_resource type="Resource" id="Page_20"]
script = ExtResource("2")
category = "Kangaroo"
title = "Race scoring and elimination"
body = "A failed slipper command directly eliminates you; there are no accumulated marks. Kangaroo uses race scoring and trap credit, with no Lagsanay placement points and no Patibong for command failures. Eligible Barya follows the ordinary race rules."
requires = "main:KANGAROO"

[sub_resource type="Resource" id="Page_21"]
script = ExtResource("2")
category = "Kangaroo"
title = "Sequential cadence"
body = "Only one slipper challenge can be active. After evaluation and cleanup, recovery drains before the next telegraph. Response and recovery shorten with each completed slipper to 3 s and 0.75 s floors. These settings are provisional."
requires = "main:KANGAROO"

[sub_resource type="Resource" id="Page_22"]
script = ExtResource("2")
category = "Kangaroo"
title = "Secured finishers"
body = "Reaching the flag secures your finish and removes you from later slipper challenges. A sole unfinished runner keeps racing and skips Hug; when no unfinished runners remain, the race closes."
requires = "main:KANGAROO"

[sub_resource type="Resource" id="Page_23"]
script = ExtResource("2")
category = "Accessibility"
title = "Who is who"
body = "Every chicken has a number and a shape (1 circle, 2 triangle, 3 square, 4 diamond) shown above it and in the HUD. Colour is only an extra."
requires = ""

[sub_resource type="Resource" id="Page_24"]
script = ExtResource("2")
category = "Accessibility"
title = "Cues you can see and hear"
body = "Every sound has a picture or a word with it: the taya is marked TAYA with its number, Kangaroo commands show an icon, a name and a timing ring, hazards show their path or lane, and a blocked placement says why. The game can be played with the sound off."
requires = ""

[sub_resource type="Resource" id="Page_25"]
script = ExtResource("2")
category = "Accessibility"
title = "Screen shake"
body = "Screen shake can be Full, Reduced or Off in Settings. Current setting: {shake_mode}. Every command stays readable with shake off."
requires = ""

[sub_resource type="Resource" id="Page_26"]
script = ExtResource("2")
category = "Accessibility"
title = "Sound"
body = "Settings has Master, Music, Effects and Crowd volumes and a Mute switch. Muting never hides information: every cue has a visual partner."
requires = ""

[sub_resource type="Resource" id="Page_27"]
script = ExtResource("2")
category = "Accessibility"
title = "Cheering"
body = "A chicken that is out or has finished can cheer during Play with the Rotate key (R, Right Shift or West). A cheer never changes scores, timers or movement and has a 1 s cooldown."
requires = ""

[sub_resource type="Resource" id="Page_28"]
script = ExtResource("2")
category = "Accessibility"
title = "Display"
body = "The game is laid out for 1280 x 720 and scales to 1920 x 1080. Wider windows keep the same view with bars at the sides. No effect flashes rapidly; the Parol uses a slow brightness ramp."
requires = ""

[sub_resource type="Resource" id="Page_29"]
script = ExtResource("2")
category = "Barya"
title = "The round coin"
body = "On some Karera rounds, one Pugad egg may offer Barya. Place its 1×1 coin during Place; it is a temporary objective, not construction. Touch it to carry it. Capture keeps it with you; elimination drops it. Carry it to the flag while alive for +{barya}. It disappears after the round is scored."
requires = "feature:barya"

