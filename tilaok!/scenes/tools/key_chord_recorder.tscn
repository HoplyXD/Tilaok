[node name="Help" type="Label" parent="Safe/Content"]
layout_mode = 2
text = "Hold the shown keys together. PASS is recorded when every key is down at once. Insert = could not (LOST). Page Down = skip. Page Up = back. F2 = print the report. Home = restart. End = leave."
