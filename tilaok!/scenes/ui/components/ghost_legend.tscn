theme_override_constants/separation = 8

[node name="Mark" type="Label" parent="LegendProtected/Row"]
layout_mode = 2
text = "[LOCK]"
theme_type_variation = &"HudLabel"
custom_minimum_size = Vector2(96, 0)

[node name="Text" type="Label" parent="LegendProtected/Row"]
layout_mode = 2
text = "Protected zone: no building"
theme_type_variation = &"BodyLabel"
size_flags_horizontal = 3

[node name="LegendRotationOff" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"GhostRotationOff"
unique_name_in_owner = true

[node name="Row" type="HBoxContainer" parent="LegendRotationOff"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Mark" type="Label" parent="LegendRotationOff/Row"]
layout_mode = 2
