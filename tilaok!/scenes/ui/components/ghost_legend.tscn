[gd_scene load_steps=1 format=3]



[node name="GhostLegend" type="VBoxContainer"]
layout_mode = 3
theme_override_constants/separation = 6

[node name="Art_LegendIcons" type="TextureRect" parent="."]
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5
visible = false
metadata/asset_id = "ui.place.legend_icons"

[node name="LegendValid" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"GhostValid"
unique_name_in_owner = true

[node name="Row" type="HBoxContainer" parent="LegendValid"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Mark" type="Label" parent="LegendValid/Row"]
layout_mode = 2
text = "[OK]"
theme_type_variation = &"HudLabel"
custom_minimum_size = Vector2(96, 0)

[node name="Text" type="Label" parent="LegendValid/Row"]
layout_mode = 2
text = "Valid: you can place here"
theme_type_variation = &"BodyLabel"
size_flags_horizontal = 3

[node name="LegendInvalid" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"GhostInvalid"
unique_name_in_owner = true

[node name="Row" type="HBoxContainer" parent="LegendInvalid"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Mark" type="Label" parent="LegendInvalid/Row"]
layout_mode = 2
text = "[X]"
theme_type_variation = &"HudLabel"
custom_minimum_size = Vector2(96, 0)

[node name="Text" type="Label" parent="LegendInvalid/Row"]
layout_mode = 2
text = "Blocked: the reason is shown"
theme_type_variation = &"BodyLabel"
size_flags_horizontal = 3

[node name="LegendProtected" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"GhostProtected"
unique_name_in_owner = true

[node name="Row" type="HBoxContainer" parent="LegendProtected"]
